   <string notr="true">QDialog#TaskDialog {
    background-color: #F3F3F3;
    color: #000000;
}

QLabel {
    color: #000000;
    background-color: transparent;
}

QLineEdit,
QTextEdit,
QDateEdit,
QSpinBox,
QComboBox {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #E8C5D1;
    border-radius: 7px;
    padding: 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QDateEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid #E8A5BA;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    selection-background-color: #F8DDE6;
    selection-color: #000000;
}

QDialogButtonBox QPushButton {
    background-color: #F2C2D1;
    color: #000000;
    border: 1px solid #EAB1C3;
    border-radius: 8px;
    padding: 8px 18px;
}

QDialogButtonBox QPushButton:hover {
    background-color: #E8A5BA;
}
</string>
