  <property name="styleSheet">
   <string notr="true">/* Общий фон приложения */
QMainWindow,
QWidget#centralwidget,
QWidget#todayTab,
QWidget#kanbanTab,
QWidget#calendarTab {
    background-color: #F3F3F3;
    color: #000000;
}

/* Область вкладок и рабочая зона */
QTabWidget::pane {
    background-color: #F3F3F3;
    border: 1px solid #DCDCDC;
    top: -1px;
}

QTabBar {
    background-color: #F3F3F3;
}

/* Вкладки */
QTabBar::tab {
    background-color: #FBE7EE;
    color: #000000;
    border: 1px solid #EED5DE;
    border-radius: 7px;
    padding: 8px 18px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background-color: #F2C2D1;
}

QTabBar::tab:hover {
    background-color: #F8DDE6;
}

/* Надписи */
QLabel {
    color: #000000;
    background-color: transparent;
}

/* Поле выбора даты */
QDateEdit {
    background-color: #FAFAFA;
    color: #000000;
    border: 1px solid #D8D8D8;
    border-radius: 6px;
    padding: 5px;
}

/* Таблица */
QTableWidget {
    background-color: #FAFAFA;
    color: #000000;
    border: 1px solid #D8D8D8;
    gridline-color: #E8E8E8;
    selection-background-color: #F8DDE6;
    selection-color: #000000;
}

/* Заголовки таблицы */
QHeaderView::section {
    background-color: #FBE7EE;
    color: #000000;
    border: 1px solid #EED5DE;
    padding: 6px;
}

/* Блок автоматического расписания */
QGroupBox#scheduleGroupBox {
    background-color: #F7F7F7;
    color: #000000;
    border: 1px solid #D8D8D8;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px;
}

QGroupBox#scheduleGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}

/* Поле расписания */
QTextBrowser#scheduleBrowser {
    background-color: #FAFAFA;
    color: #000000;
    border: 1px solid #D8D8D8;
    border-radius: 6px;
    padding: 8px;
}

/* Кнопка &quot;Составить расписание&quot; */
QPushButton#planDayButton {
    background-color: #E8A5BA;
    color: #000000;
    border: none;
    border-radius: 9px;
    padding: 9px 16px;
}

QPushButton#planDayButton:hover {
    background-color: #DB91AA;
}

QPushButton#planDayButton:pressed {
    background-color: #CC7E99;
}</string>
  </property>
